return function(fixture: { owner_id: number, track_id: number, foreign_id: number, foreign_entry: number })
	local playlists = require("@lyra/playlists")
	local id = playlists.create({ user_id = fixture.owner_id, name = "Delete me" })
	local entry = playlists.add_track(id, fixture.track_id)
	local playlist = playlists.get_by_id(id)
	assert(playlist ~= nil)
	assert(playlists.delete(fixture.foreign_id) == false)
	assert(playlists.delete(fixture.track_id) == false)
	assert(playlists.delete("missing-playlist") == false)
	assert(playlists.delete(999999999) == false)
	assert(playlists.delete(playlist.id) == true)
	assert(playlists.get_by_id(id) == nil)
	assert(playlists.delete(id) == false)
	assert(entry ~= nil and playlists.remove_track(entry) == false)
	assert(playlists.get_by_id(fixture.foreign_id) ~= nil)
	assert(not pcall(playlists.delete, {}))
end
